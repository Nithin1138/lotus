<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../DropDial/UiTheme.cs" Link="UiTheme.cs"/>
    <Compile Include="../DropDial/ContinuousFrame.cs" Link="ContinuousFrame.cs"/>
    <Compile Include="../DropDial/RotationDial.cs" Link="RotationDial.cs"/>
    <Compile Include="../DropDial/RotationGeometry.cs" Link="RotationGeometry.cs"/>
    <Compile Include="../DropDial/AppIcon.cs" Link="AppIcon.cs"/>
    <Compile Include="../DropDial/Strings.cs" Link="Strings.cs"/>
    <Compile Include="../DropDial/Settings.cs" Link="Settings.cs"/>
    <Compile Include="../DropDial/StartupManager.cs" Link="StartupManager.cs"/>
    <EmbeddedResource Include="../DropDial/assets/dropdial.ico" LogicalName="DropDial.AppIcon"/>
    <EmbeddedResource Include="../DropDial/assets/tray.ico" LogicalName="DropDial.TrayIcon"/>
  </ItemGroup>
</Project>
