    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Lotus/UiTheme.cs" Link="UiTheme.cs"/>
    <Compile Include="../Lotus/ContinuousFrame.cs" Link="ContinuousFrame.cs"/>
    <Compile Include="../Lotus/RotationDial.cs" Link="RotationDial.cs"/>
    <Compile Include="../Lotus/RotationGeometry.cs" Link="RotationGeometry.cs"/>
    <Compile Include="../Lotus/AppIcon.cs" Link="AppIcon.cs"/>
    <Compile Include="../Lotus/Strings.cs" Link="Strings.cs"/>
    <Compile Include="../Lotus/Settings.cs" Link="Settings.cs"/>
    <Compile Include="../Lotus/StartupManager.cs" Link="StartupManager.cs"/>
    <EmbeddedResource Include="../Lotus/assets/lotus.ico" LogicalName="Lotus.AppIcon"/>
  </ItemGroup>
</Project>
