# DropDial Licensing & Payment Gateway Configuration
# ====================================================

# 1. Razorpay Payment Gateway
# Get these from Razorpay Dashboard (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (Set in Dashboard > Settings > Webhooks)
# Webhook URL: https://your-domain.vercel.app/api/razorpay-webhook
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# 2. Resend Email Delivery (Recommended)
# Get your API key from Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=DropDial Pro <licenses@yourdomain.com>

# 3. Licensing Private Key (For Vercel deployment)
# Paste the full content of licensing/keys/private.pem (or leave unset for local dev file lookup)
# LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# 4. Optional SMTP Fallback (Only needed if Resend is not used)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=support@dropdial.com
FROM_NAME=DropDial Pro

# 5. Local Server Port (For local python server only)
PORT=8080
ADMIN_KEY=your_secure_admin_key_here
