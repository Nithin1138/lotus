# DropDial Licensing Server Environment Configuration

# Server Port
PORT=8080

# Razorpay Webhook Secret (Set this in Razorpay Dashboard > Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Admin Secret Key (Used for manual /admin/issue API calls)
ADMIN_KEY=your_secure_admin_key_here

# SMTP Email Configuration (For automatically emailing license keys to buyers)
# Example using Gmail:
# - SMTP_HOST=smtp.gmail.com
# - SMTP_PORT=587
# - SMTP_USER=your_email@gmail.com
# - SMTP_PASS=your_gmail_16_digit_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=support@dropdial.com
FROM_NAME=DropDial Pro
