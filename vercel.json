{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/downloads/DropDial-Windows-Update.zip",
      "destination": "https://github.com/Nithin1138/lotus/releases/download/v1.0.1.9/DropDial-Windows-Update.zip",
      "permanent": false
    },
    {
      "source": "/downloads/DropDial-Windows-x64.zip",
      "destination": "https://github.com/Nithin1138/lotus/releases/download/v1.0.1.9/DropDial-Windows-x64.zip",
      "permanent": false
    },
    {
      "source": "/download/win",
      "destination": "/downloads/DropDial-Setup.exe",
      "permanent": false
    },
    {
      "source": "/download/windows",
      "destination": "/downloads/DropDial-Setup.exe",
      "permanent": false
    },
    {
      "source": "/download/mac",
      "destination": "/downloads/DropDial.dmg",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/download/(.*)", "destination": "/api/download?os=$1" },
    { "source": "/download", "destination": "/api/download" },
    { "source": "/api/releases/latest", "destination": "/api/releases" },
    { "source": "/api/deactivate", "destination": "/api/activate?action=deactivate" },
    { "source": "/api/status", "destination": "/api/admin?action=status" },
    { "source": "/api/payment-failed", "destination": "/api/verify-payment?action=payment-failed" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/website/$1" }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
