{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/downloads/DropDial-Windows-Update.zip",
      "destination": "https://github.com/Nithin1138/lotus/releases/download/v1.0.2.0/DropDial-Windows-Update.zip",
      "permanent": false
    },
    {
      "source": "/downloads/DropDial-Windows-x64.zip",
      "destination": "https://github.com/Nithin1138/lotus/releases/download/v1.0.2.0/DropDial-Windows-x64.zip",
      "permanent": false
    },
    {
      "source": "/download/win",
      "destination": "/downloads/DropDial-Setup.exe",
      "permanent": false
    },
    {
      "source": "/download/windows",
      "destination": "/downloads/DropDial-Setup.exe",
      "permanent": false
    },
    {
      "source": "/download/mac",
      "destination": "/downloads/DropDial.dmg",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/download/(.*)", "destination": "/api/download?os=$1" },
    { "source": "/download", "destination": "/api/download" },
    { "source": "/api/releases/latest", "destination": "/api/releases" },
    { "source": "/api/deactivate", "destination": "/api/activate?action=deactivate" },
    { "source": "/api/status", "destination": "/api/admin?action=status" },
    { "source": "/api/payment-failed", "destination": "/api/verify-payment?action=payment-failed" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/website/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://api.razorpay.com https://cdn.jsdelivr.net https://js.dodopayments.com https://checkout.dodopayments.com https://test.checkout.dodopayments.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https://checkout.razorpay.com https://api.razorpay.com https://lumberjack.razorpay.com https://api.country.is https://api.github.com https://api.dodopayments.com https://test.dodopayments.com https://checkout.dodopayments.com https://test.checkout.dodopayments.com; frame-src 'self' https://api.razorpay.com https://checkout.razorpay.com https://checkout.dodopayments.com https://test.checkout.dodopayments.com; object-src 'none'; base-uri 'self'; form-action 'self';"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
